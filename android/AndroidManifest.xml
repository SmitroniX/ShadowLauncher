<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.shadow.launcher"
    android:versionCode="101"
    android:versionName="1.0.1">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- Main Dashboard -->
        <activity
            android:name="com.shadow.launcher.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Native In-Game 3D OpenGL & Pojav Controls Activity -->
        <activity
            android:name="com.shadow.launcher.InGameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:label="Minecraft"
            android:screenOrientation="sensorLandscape" />

        <!-- Pojav Custom Controls Layout Editor -->
        <activity
            android:name="com.shadow.launcher.ControlsEditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:label="Custom Controls"
            android:screenOrientation="sensorLandscape" />

        <!-- Java & Memory Settings -->
        <activity
            android:name="com.shadow.launcher.SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:label="Settings"
            android:screenOrientation="sensorLandscape" />

        <!-- Real-Time JVM Console Log Activity -->
        <activity
            android:name="com.shadow.launcher.ConsoleLogActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:label="Console Output"
            android:screenOrientation="sensorLandscape" />

    </application>

</manifest>
