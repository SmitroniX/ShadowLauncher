<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ScrollView
        android:id="@+id/dashboard_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/_background_display_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/_10sdp">

            <!-- Cyber Gaming Dashboard Hero Banner -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/dashboard_hero_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/bg_cyber_hero_card"
                android:padding="@dimen/_8sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/dashboard_system_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_hero_title"
                    android:textColor="@color/accent_cyan"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/dashboard_status_indicator" />

                <TextView
                    android:id="@+id/dashboard_status_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_status_active"
                    android:textColor="@color/accent_green"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/dashboard_system_title"
                    app:layout_constraintBottom_toBottomOf="@id/dashboard_system_title" />

                <LinearLayout
                    android:id="@+id/status_badges_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_6sdp"
                    app:layout_constraintTop_toBottomOf="@id/dashboard_system_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- 144 FPS UNLOCKED Badge -->
                    <TextView
                        android:id="@+id/badge_fps_unlocked"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:background="@drawable/badge_fps_pill"
                        android:gravity="center"
                        android:paddingVertical="@dimen/_5sdp"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:text="@string/dashboard_badge_fps"
                        android:textColor="@color/accent_cyan"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <!-- JAVA 25 READY Badge -->
                    <TextView
                        android:id="@+id/badge_java25_ready"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:background="@drawable/badge_java25_pill"
                        android:gravity="center"
                        android:paddingVertical="@dimen/_5sdp"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:text="@string/dashboard_badge_java"
                        android:textColor="@color/accent_purple"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dashboard_system_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="@string/dashboard_hero_subtitle"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/_8ssp"
                    android:letterSpacing="0.05"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/status_badges_container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/quick_actions_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:text="@string/dashboard_matrix_label"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/_8ssp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/dashboard_hero_card"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Center Guideline for 2-column grid -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/center_guideline"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5"/>

            <!-- Row 1: Wiki (Left) & Discord (Right) -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="0dp"
                android:text="@string/mcl_tab_wiki"
                android:drawableStart="@drawable/ic_menu_news"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:layout_constraintTop_toBottomOf="@id/quick_actions_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/social_divider" />

            <View
                android:id="@+id/social_divider"
                style="@style/LauncherFragment_Divider"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/news_button"
                app:layout_constraintStart_toStartOf="@id/center_guideline"
                app:layout_constraintEnd_toEndOf="@id/center_guideline"
                app:layout_constraintBottom_toBottomOf="@id/news_button"/>

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/discord_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="0dp"
                android:text="@string/mcl_button_discord"
                android:drawableStart="@drawable/ic_discord"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                app:layout_constraintTop_toTopOf="@id/news_button"
                app:layout_constraintBottom_toBottomOf="@id/news_button"
                app:layout_constraintStart_toEndOf="@id/social_divider"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Row 2: Custom Controls (Left) & Install JAR (Right) -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="0dp"
                android:text="@string/mcl_option_customcontrol"
                android:drawableStart="@drawable/ic_menu_custom_controls"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:layout_constraintTop_toBottomOf="@id/news_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/center_guideline" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="0dp"
                android:text="@string/main_install_jar_file"
                android:drawableStart="@drawable/ic_menu_install_jar"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                app:layout_constraintTop_toTopOf="@id/custom_control_button"
                app:layout_constraintBottom_toBottomOf="@id/custom_control_button"
                app:layout_constraintStart_toEndOf="@id/center_guideline"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Row 3: Share Logs (Left) & Directory (Right) -->
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="0dp"
                android:text="@string/main_share_logs"
                android:drawableStart="@drawable/ic_share_cyber"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:layout_constraintTop_toBottomOf="@id/custom_control_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/center_guideline" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="0dp"
                android:text="@string/mcl_button_open_directory"
                android:drawableStart="@drawable/ic_folder"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                app:layout_constraintTop_toTopOf="@id/share_logs_button"
                app:layout_constraintBottom_toBottomOf="@id/share_logs_button"
                app:layout_constraintStart_toEndOf="@id/center_guideline"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Sleek Glassmorphic Bottom Dock Container -->
    <View
        android:id="@+id/_background_display_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_bottom_bar_glass"
        android:translationZ="-1dp"
        app:layout_constraintTop_toTopOf="@id/_version_selector_bg"
        android:layout_marginTop="-6dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Version Selector Glass Capsule Card -->
    <View
        android:id="@+id/_version_selector_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_version_selector_card"
        android:translationZ="0dp"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner"
        app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
        app:layout_constraintStart_toStartOf="@id/mc_version_spinner"
        android:layout_marginStart="-6dp"
        app:layout_constraintEnd_toEndOf="@id/edit_profile_button"
        android:layout_marginEnd="-6dp" />

    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="0dp"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:background="@android:color/transparent"
        android:drawableEnd="@drawable/spinner_arrow"
        android:textColor="@color/primary_text"

        app:drawableEndPadding="@dimen/_1sdp"
        app:drawableEndSize="@dimen/_12sdp"
        app:drawableStartIntegerScaling="true"
        app:drawableStartSize="@dimen/_30sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/edit_profile_button"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:background="@drawable/bg_icon_button"
        android:padding="@dimen/_5sdp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_edit_profile"
        app:layout_constraintBottom_toBottomOf="@+id/mc_version_spinner"
        app:layout_constraintEnd_toStartOf="@+id/play_button"
        app:layout_constraintTop_toTopOf="@+id/mc_version_spinner" />

    <!-- High-Visibility Play Button -->
    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="@dimen/_140sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:elevation="6dp"
        android:letterSpacing="0.08"
        android:text="@string/main_play"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mc_version_spinner" />

</androidx.constraintlayout.widget.ConstraintLayout>
