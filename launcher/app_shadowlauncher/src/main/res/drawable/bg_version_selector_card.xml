<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted Glass Specular Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient
                android:startColor="#33FFFFFF"
                android:centerColor="#1838BDF8"
                android:endColor="#14FFFFFF"
                android:angle="135"/>
        </shape>
    </item>
    <!-- Translucent Frosted Glass Capsule Surface -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp"/>
            <gradient
                android:startColor="#241E293B"
                android:centerColor="#1A152234"
                android:endColor="#140F172A"
                android:angle="270"/>
        </shape>
    </item>
</layer-list>
