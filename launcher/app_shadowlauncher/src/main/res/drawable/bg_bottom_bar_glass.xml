<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top Frosted Glass Specular Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp"/>
            <gradient
                android:startColor="#33FFFFFF"
                android:centerColor="#2038BDF8"
                android:endColor="#33FFFFFF"
                android:angle="0"/>
        </shape>
    </item>
    <!-- Translucent Frosted Glass Dock Body -->
    <item android:top="1.2dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="21dp" android:topRightRadius="21dp"/>
            <gradient
                android:startColor="#F0111827"
                android:centerColor="#F50D121F"
                android:endColor="#FA070A12"
                android:angle="270"/>
        </shape>
    </item>
</layer-list>
