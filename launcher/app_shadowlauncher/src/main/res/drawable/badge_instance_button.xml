<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <solid android:color="#1A2D48"/>
            <stroke android:width="1.5dp" android:color="@color/accent_cyan"/>
            <padding android:left="10dp" android:right="10dp" android:top="6dp" android:bottom="6dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <solid android:color="@color/card_surface"/>
            <stroke android:width="1dp" android:color="@color/card_border"/>
            <padding android:left="10dp" android:right="10dp" android:top="6dp" android:bottom="6dp"/>
        </shape>
    </item>
</selector>
