<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Specular Glass Edge (Frosted Translucent Stroke) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <gradient
                android:startColor="#40FFFFFF"
                android:centerColor="#2038BDF8"
                android:endColor="#14FFFFFF"
                android:angle="135"/>
        </shape>
    </item>
    <!-- Frosted Glass Dark Slate Card Surface -->
    <item android:top="1.2dp" android:bottom="1.2dp" android:left="1.2dp" android:right="1.2dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp"/>
            <gradient
                android:startColor="#262A374A"
                android:centerColor="#1E162032"
                android:endColor="#180F172A"
                android:angle="270"/>
        </shape>
    </item>
</layer-list>
