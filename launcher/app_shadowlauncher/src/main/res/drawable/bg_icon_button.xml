<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4000F0FF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <solid android:color="#2A3D5E"/>
                    <stroke android:width="1.2dp" android:color="#00F0FF"/>
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <solid android:color="#20304D"/>
                    <stroke android:width="1.5dp" android:color="#00F0FF"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <gradient
                        android:startColor="#1E2A3E"
                        android:endColor="#141D2C"
                        android:angle="270"/>
                    <stroke android:width="1dp" android:color="#2B3D5C"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
