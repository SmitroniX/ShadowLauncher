<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top Glass Specular Highlight Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient
                android:startColor="#60FFFFFF"
                android:centerColor="#30FFFFFF"
                android:endColor="#18FFFFFF"
                android:angle="135"/>
        </shape>
    </item>
    <!-- Modern Glassmorphic Indigo-Violet CTA Core -->
    <item android:top="1.2dp" android:bottom="1.2dp" android:left="1.2dp" android:right="1.2dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp"/>
            <gradient
                android:startColor="#8B5CF6"
                android:centerColor="#7C3AED"
                android:endColor="#6366F1"
                android:angle="135"/>
        </shape>
    </item>
</layer-list>
