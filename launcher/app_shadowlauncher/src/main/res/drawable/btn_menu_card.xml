<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#338B5CF6">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp"/>
                    <solid android:color="#1A2438"/>
                    <stroke android:width="1.5dp" android:color="#8B5CF6"/>
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp"/>
                    <solid android:color="#182030"/>
                    <stroke android:width="1.5dp" android:color="#06B6D4"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp"/>
                    <solid android:color="#121824"/>
                    <stroke android:width="1dp" android:color="#222E46"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
